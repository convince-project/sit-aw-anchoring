COMPOSE_FILE=docker-compose.yml:docker-compose-jazzy.yml

IMAGE_NAME=sit-aw-anchoring
TAG=0.3.0-jazzy

CONTAINER=sit_aw_anchoring_030_jazzy_ctr

PROJECT_DIR=${PWD}

ROS_WS_VOLUME=${PROJECT_DIR}/volumes/humble_ws
TQL_VOLUME=${PROJECT_DIR}/volumes/tql
DT_VOLUME=${PROJECT_DIR}/volumes/dt-simulator

HISTFILE=${PROJECT_DIR}/.bash_history

USERNAME=user

UID=$(shell id -u)
GID=$(shell id -g)